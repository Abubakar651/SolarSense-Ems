# Copy to .env and fill in. .env is gitignored; never commit real values.

# Supabase Postgres connection string (Project Settings > Database > Connection string > Session pooler).
# Keep the "+psycopg" driver prefix and sslmode=require.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# At least 32 bytes. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Optional token lifetimes (defaults shown).
ACCESS_TOKEN_TTL_HOURS=12
REMEMBER_TOKEN_TTL_DAYS=30

# "false" (DEVELOPMENT ONLY) lets new accounts log in without confirming their email; signup then
# goes straight to onboarding. Leave unset or "true" in production.
REQUIRE_EMAIL_VERIFICATION=false
# How verify/reset emails go out:
#   resend   real email through Resend (default; needs RESEND_API_KEY and EMAIL_FROM)
#   console  LOCAL DEVELOPMENT ONLY: the links are printed in the API's terminal instead of emailed
EMAIL_DELIVERY=console
# Resend (https://resend.com) API key and a sender on a domain you verified there.
RESEND_API_KEY=
EMAIL_FROM=SolarSense <no-reply@your-domain.com>

# Where the Next.js app runs; used for email links and as the default CORS origin.
FRONTEND_URL=http://localhost:3000
# Optional comma-separated extra origins (no "*").
CORS_ORIGINS=
# IP of the Next.js server, so the API trusts its X-Forwarded-For for per-client rate limits.
TRUSTED_PROXIES=127.0.0.1

# Seconds between polls of the GoodWe inverter (192.168.100.102) for the telemetry log that the live
# forecast learns recent history from. Needs the API on the home network; 0 switches the logger off.
INVERTER_POLL_SECONDS=300

# Email of the account that owns the recorded LHR-RES-01 history (499 days in data/processed). Only that
# account, once its email is verified, sees it; every other account sees only its own inverter's data.
# Leave empty and nobody gets it. Set it before running `alembic upgrade head` too.
STATION_OWNER_EMAIL=

# Existing: Kaggle token for dataset download scripts.
KAGGLE_API_TOKEN=
