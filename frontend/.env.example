# The SolarSense API (FastAPI, repo root). Called only from the Next.js server, never the browser.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# "true" serves every screen from the typed mock repositories and skips sign-in.
# "false" uses the API for sign-in and account data. Set before `pnpm build`: NEXT_PUBLIC_* values are
# baked into the build.
NEXT_PUBLIC_USE_MOCKS=true
